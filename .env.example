# Em dev local/LAN, 127.0.0.1/localhost é trocado pelo hostname da página
# (ex.: http://10.0.0.164:3000 → API em http://10.0.0.164:5000/api/v1/).
# Em produção o build usa .env.production:
# REACT_APP_API_URL=https://api-faturas.devls.com.br/api/v1/
REACT_APP_API_URL=http://127.0.0.1:5000/api/v1/
ESLINT_NO_DEV_ERRORS=true
